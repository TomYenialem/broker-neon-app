  "userId": "{{userId}}",
  "landDetails": {
    "totalArea": 800,
    "areaUnit": "SQUARE_METERS",
    "topography": "FLAT",
    "distanceFromMainRoad": 50,
    "isDemarcated": true,
    "documentType": "TITLE_DEED",
    "landPurpose": "RESIDENTIAL",
    "zoningType": "RESIDENTIAL",
