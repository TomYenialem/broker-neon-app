    "waterAccess": "CONNECTED",
    "sanitationAccess": "CONNECTED",
    "securityInfo": "Condomínio fechado com segurança 24h"
  }
}

### 17. Update Land Listing (Protected)
PATCH {{baseUrl}}/land-listings/land-id-here
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 4500000,
  "status": "ACTIVE"
}

### 18. Delete Land Listing (Protected)
DELETE {{baseUrl}}/land-listings/land-id-here
Authorization: Bearer {{token}}

