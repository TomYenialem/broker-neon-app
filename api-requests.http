  "images": [
    "https://example.com/machine1.jpg",
    "https://example.com/machine2.jpg",
    "https://example.com/machine3.jpg"
  ],
  "userId": "{{userId}}",
  "machineDetails": {
    "machineType": "Excavator",
    "modelNumber": "320D",
    "condition": "USED",
