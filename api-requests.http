### API Testing File
### Use REST Client extension in VS Code or similar tools
### Replace {{token}} and {{userId}} with actual values after login

@baseUrl = http://localhost:3000/api
@token = your-token-here
@userId = your-user-id-here

###############################################
# AUTHENTICATION
###############################################

### 1. Register New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "broker@example.com",
  "password": "SecurePass123!",
  "firstName": "João",
  "lastName": "Silva",
  "phone": "+244 923 456 789",
  "role": "USER"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "broker@example.com",
  "password": "SecurePass123!"
}

### 3. Refresh Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "your-refresh-token-here"
}

### 4. Register Admin User (ADMIN Only - Protected)
POST {{baseUrl}}/auth/register-admin
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "admin@broker.com",
  "password": "AdminSecurePass123!",
  "firstName": "Admin",
  "lastName": "User",
  "phone": "+244 923 456 789",
  "role": "ADMIN"
}

### 5. Get Current User (Protected)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 6. Forgot Password (Request Reset Token)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "broker@example.com"
}

### 7. Verify Reset Token
POST {{baseUrl}}/auth/verify-reset-token
Content-Type: application/json

{
  "token": "paste-token-from-forgot-password-response"
}

### 8. Reset Password
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "paste-token-from-forgot-password-response",
  "newPassword": "NewSecurePassword123!"
}

###############################################
# USER MANAGEMENT (ADMIN ONLY)
###############################################

### 9. Get All Users (ADMIN Only - Protected)
GET {{baseUrl}}/auth/users?page=1&limit=10
Authorization: Bearer {{token}}

### 10. Get All Users - Filter by Role
GET {{baseUrl}}/auth/users?role=USER&page=1&limit=10
Authorization: Bearer {{token}}

### 11. Get All Users - Search by Name/Email/Phone
GET {{baseUrl}}/auth/users?search=João&page=1&limit=10
Authorization: Bearer {{token}}

### 12. Get All Users - Sort by Name
GET {{baseUrl}}/auth/users?sort=name_asc&page=1&limit=10
Authorization: Bearer {{token}}

### 13. Get All Users - Combined Filters
GET {{baseUrl}}/auth/users?role=ADMIN&search=admin&sort=newest&page=1&limit=5
Authorization: Bearer {{token}}

###############################################
# CAR LISTINGS
###############################################

### 5. Get All Cars (Public)
GET {{baseUrl}}/car-listings?page=1&limit=20&sort=newest

### 6. Get Cars with Filters
GET {{baseUrl}}/car-listings?province=Luanda&minPrice=10000000&maxPrice=30000000&fuelType=DIESEL

### 7. Get Available Car Makes
GET {{baseUrl}}/car-listings/makes

### 8. Get Single Car
GET {{baseUrl}}/car-listings/car-id-here

### 9. Create Car Listing (Protected)
POST {{baseUrl}}/car-listings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Toyota Land Cruiser Prado 2018, Diesel, Automático",
  "description": "Excelente condição, importado da Europa. Totalmente legalizado.",
  "price": 25000000,
  "currency": "AOA",
  "province": "Luanda",
  "municipality": "Talatona",
  "neighborhood": "Talatona Gardens",
  "images": [
    "https://example.com/car1.jpg",
    "https://example.com/car2.jpg",
    "https://example.com/car3.jpg"
  ],
  "videoUrl": "https://example.com/car-video.mp4",
  "userId": "{{userId}}",
  "carDetails": {
    "make": "Toyota",
    "model": "Land Cruiser Prado",
    "trimLevel": "VX",
    "manufactureYear": 2018,
    "registrationYear": 2019,
    "mileage": 45000,
    "fuelType": "DIESEL",
    "transmission": "AUTOMATIC",
    "condition": "EXCELLENT",
    "color": "Branco Pérola",
    "interiorType": "LEATHER",
    "vehicleOrigin": "EUROPE",
    "customsStatus": "LEGALIZED",
    "serviceHistory": true,
    "reasonForSelling": "Upgrading to newer model",
    "features": ["4x4", "Air Conditioning", "Cruise Control", "Sunroof", "Parking Sensors"]
  }
}

### 10. Update Car Listing (Protected)
PATCH {{baseUrl}}/car-listings/car-id-here
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 24000000,
  "description": "Price reduced! Excellent condition."
}

### 11. Delete Car Listing (Protected)
DELETE {{baseUrl}}/car-listings/car-id-here
Authorization: Bearer {{token}}

###############################################
# LAND LISTINGS
###############################################

### 12. Get All Land (Public)
GET {{baseUrl}}/land-listings?page=1&limit=20

### 13. Get Land with Filters
GET {{baseUrl}}/land-listings?province=Benguela&landPurpose=AGRICULTURAL

### 14. Get Single Land
GET {{baseUrl}}/land-listings/land-id-here

### 15. Create Land Listing (Protected) - Agricultural
POST {{baseUrl}}/land-listings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Terreno de 5 Hectares para Agricultura, Benguela",
  "description": "Terreno plano com acesso à água, ideal para cultivo de café ou milho",
  "price": 5000000,
  "currency": "AOA",
  "province": "Benguela",
  "municipality": "Lobito",
  "neighborhood": "Caponte",
  "images": [
    "https://example.com/land1.jpg",
    "https://example.com/land2.jpg"
  ],
  "userId": "{{userId}}",
  "landDetails": {
    "totalArea": 50000,
    "areaUnit": "SQUARE_METERS",
    "topography": "FLAT",
    "distanceFromMainRoad": 500,
    "isDemarcated": true,
    "documentType": "TITLE_DEED",
    "landPurpose": "AGRICULTURAL",
    "waterSource": "Rio nearby (200m), poço artesiano no terreno",
    "hasIrrigationSystem": false,
    "soilType": "LOAMY",
    "soilTested": true,
    "previousUse": "Coffee plantation",
    "agriculturalSupport": "Cooperative nearby, MINAGRI extension office",
    "climateInfo": "High rainfall season Oct-April, avg 1200mm/year"
  }
}

### 16. Create Land Listing (Protected) - Residential
POST {{baseUrl}}/land-listings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Loteamento para Construção, Talatona, Luanda",
  "description": "Terreno para construção residencial em zona nobre",
