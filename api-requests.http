# HOUSE LISTINGS
###############################################

### 19. Get All Houses (Public)
GET {{baseUrl}}/house-listings?page=1&limit=20

### 20. Get Houses with Filters
GET {{baseUrl}}/house-listings?province=Luanda&minBedrooms=3&maxBedrooms=5&houseType=DETACHED

### 21. Get Single House
GET {{baseUrl}}/house-listings/house-id-here

### 22. Create House Listing (Protected)
POST {{baseUrl}}/house-listings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Moradia T4 com Piscina, Talatona",
  "description": "Casa moderna com todas as comodidades, acabamentos de luxo",
  "price": 85000000,
  "currency": "AOA",
  "province": "Luanda",
  "municipality": "Talatona",
  "neighborhood": "Talatona Gardens",
  "images": [
    "https://example.com/house1.jpg",
    "https://example.com/house2.jpg",
    "https://example.com/house3.jpg"
  ],
  "videoUrl": "https://example.com/house-tour.mp4",
  "userId": "{{userId}}",
  "houseDetails": {
    "houseType": "DETACHED",
    "plotSize": 600,
    "livingArea": 350,
    "bedrooms": 4,
    "bathrooms": 3,
    "constructionQuality": "NEW_CONSTRUCTION",
    "waterSource": "PUBLIC_NETWORK",
    "hasWaterTank": true,
    "hasGenerator": true,
    "hasInverter": true,
    "securityFeatures": [
      "Electric fence",
      "CCTV cameras",
      "Security guard 24/7",
      "Alarm system"
    ],
    "interiorFeatures": [
      "Fully equipped kitchen",
      "Air conditioning in all rooms",
      "Built-in wardrobes",
      "Marble flooring",
      "Smart home system"
    ],
    "exteriorFeatures": [
      "Swimming pool",
      "Garden",
      "Garage for 2 cars",
      "Outdoor dining area",
      "Borehole"
    ],
    "distanceToCityCenter": 15,
    "distanceToSchools": 2,
    "distanceToHospitals": 5,
    "distanceToSupermarkets": 1
  }
}

