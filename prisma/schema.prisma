generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  password      String
  phone         String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  firstName     String
  lastName      String
  accounts      Account[]
  listings      Listing[]

  @@index([email])
}

model Account {
  id           String    @id @default(uuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Listing {
  id             String          @id @default(uuid())
  title          String
  description    String?
  price          Float?
  currency       Currency        @default(AOA)
  status         ListingStatus   @default(ACTIVE)
  province       String?
  municipality   String?
  neighborhood   String?
  images         Json
  category       ListingCategory
  userId         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  videos         Json            @default("[]")
  isFeatured     Boolean         @default(false)
  priceText      String?
  carDetails     CarDetails?
  houseDetails   HouseDetails?
  landDetails    LandDetails?
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineDetails MachineDetails?

  @@index([category, status, createdAt(sort: Desc)], map: "idx_listing_cat_status_createdAt")
  @@index([category, price], map: "idx_listing_cat_price")
  @@index([category, priceText], map: "idx_listing_cat_priceText")
  @@index([province, municipality, neighborhood], map: "idx_listing_location")
  @@index([userId, createdAt(sort: Desc)], map: "idx_listing_user_createdAt")
  @@index([status, createdAt(sort: Desc)], map: "idx_listing_status_createdAt")
  @@index([price], map: "idx_listing_price")
  @@index([priceText], map: "idx_listing_priceText")
  @@index([title], map: "idx_listing_title")
  @@index([description], map: "idx_listing_description")
}

/// ---- LAND ----
model LandDetails {
  listingId             String         @id
  totalArea             Float
  areaUnit              AreaUnit       @default(SQUARE_METERS)
  topography            Topography?
  distanceFromMainRoad  Float?
  isDemarcated          Boolean?
  documentType          DocumentType?
  landPurpose           LandPurpose
  waterSource           String?
  hasIrrigationSystem   Boolean?
  soilType              SoilType?
  soilTested            Boolean?
  previousUse           String?
  agriculturalSupport   String?
  climateInfo           String?
  zoningType            ZoningType?
  electricityAccess     UtilityAccess?
  waterAccess           UtilityAccess?
  sanitationAccess      UtilityAccess?
  securityInfo          String?
  additionalInformation String?
  customFeatures        Json?
  listing               Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// ---- CAR ----
model CarDetails {
  listingId             String           @id
  make                  String
  model                 String
  trimLevel             String?
  manufactureYear       Int?
  registrationYear      Int?
  mileage               Float?
  fuelType              FuelType
  transmission          Transmission
  condition             VehicleCondition
  color                 String?
  interiorType          InteriorType?
  vehicleOrigin         VehicleOrigin?
  customsStatus         CustomsStatus
  serviceHistory        Boolean?
  reasonForSelling      String?
  features              Json?
  additionalInformation String?
  customFeatures        Json?
  listing               Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// ---- HOUSE ----
model HouseDetails {
  listingId              String              @id
  houseType              HouseType
  plotSize               Float?
  livingArea             Float?
  bedrooms               Int?
  bathrooms              Int?
  constructionQuality    ConstructionQuality
  waterSource            WaterSource?
  hasWaterTank           Boolean?
  hasGenerator           Boolean?
  hasInverter            Boolean?
  securityFeatures       Json
  interiorFeatures       Json
  exteriorFeatures       Json
  distanceToCityCenter   Float?
  distanceToSchools      Float?
  distanceToHospitals    Float?
  distanceToSupermarkets Float?
  additionalInformation  String?
  customFeatures         Json?
  listing                Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// ---- MACHINE ----
model MachineDetails {
  listingId              String                  @id
  machineType            String
  modelNumber            String?
  condition              MachineCondition
  manufactureYear        Int?
  hoursOfUse             Float?
  workingCapacity        String?
  specifications         String?
  serviceHistory         Boolean?
  reasonForSale          String?
  sparePartsAvailability SparePartsAvailability?
  currentLocation        String?
  additionalInformation  String?
  customFeatures         Json?
  listing                Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

enum ListingCategory {
  LAND
  CAR
  HOUSE
  MACHINE
}

enum UserRole {
  ADMIN
  USER
}

enum Currency {
  AOA
  USD
}

enum ListingStatus {
  ACTIVE
  SOLD
  PENDING
  EXPIRED
}

enum AreaUnit {
  SQUARE_METERS
  HECTARES
}

enum Topography {
  FLAT
  SLOPED
  HILLY
}

enum DocumentType {
  TITLE_DEED
  SURFACE_RIGHT
  ASSIGNMENT_CONTRACT
  LAND_USE_LICENSE
}

enum LandPurpose {
  AGRICULTURAL
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
}

enum SoilType {
  SANDY
  CLAY
  LOAMY
}

enum ZoningType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
}

enum UtilityAccess {
  CONNECTED
  NEARBY
  NOT_AVAILABLE
  FEASIBLE
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum VehicleCondition {
  NEW
  EXCELLENT
  GOOD
  NEEDS_REPAIR
}

enum InteriorType {
  LEATHER
  FABRIC
}

enum VehicleOrigin {
  EUROPE
  ASIA
  AMERICA
  AFRICA
}

enum CustomsStatus {
  LEGALIZED
  PENDING
  NOT_LEGALIZED
}

enum HouseType {
  DETACHED
  TOWNHOUSE
  VILLA
  APARTMENT
}

enum ConstructionQuality {
  NEW_CONSTRUCTION
  RECENTLY_RENOVATED
  GOOD_CONDITION
  NEEDS_RENOVATION
}

enum WaterSource {
  PUBLIC_NETWORK
  PRIVATE_WELL
  BOTH
}

enum MachineCondition {
  NEW
  USED
  RECONDITIONED
}

enum SparePartsAvailability {
  EASILY_AVAILABLE
  AVAILABLE
  DIFFICULT
  NOT_AVAILABLE
}
